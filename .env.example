# =====================================================================
# Mercatus Arena — environment variables
# Copy this file to `.env` (root) and adjust values for your machine.
#   cp .env.example .env
# =====================================================================

# ---- Server (server/) ----
# Postgres connection string (Render provides this; local default matches docker-compose)
DATABASE_URL=postgres://mercatus:mercatus@localhost:5432/mercatus

# JWT signing secret (Render blueprint auto-generates; use a strong value in production)
JWT_SECRET=change-me-to-a-long-random-string

# Seeded admin account (used once, then teams register themselves)
ADMIN_EMAIL=admin@mercatus.tech
ADMIN_PASSWORD=change-me-strong-admin-password

# CORS allowlist for the portal (comma-separated; * opens to any origin)
CORS_ORIGIN=http://localhost:3030

# Gate self-service registration (required in production)
REGISTRATION_CODE=change-me

# ---- Engine & infrastructure ----
PORT=4040
TICK_INTERVAL_MS=1000
MAX_ROWS_PER_TICK=5000
PG_POOL_SIZE=20
RATE_LIMIT_STORE=postgres        # "postgres" (shared, default) or "memory" (single instance)

# Event defaults (overridable per event from the Admin Console)
DEFAULT_START_CAPITAL=100000
DEFAULT_EVENT_MINUTES=180
DEFAULT_BLACKOUT_MINUTES=20
DEFAULT_API_FREEZE_MINUTES=15
DEFAULT_NOISE_SIGMA=0.0005

# Rate limits (requests per minute per client)
RATE_LIMIT_API=300
RATE_LIMIT_AUTH=500
RATE_LIMIT_TRADE=60

# Brokerage simulation
FEE_PER_TRADE=10
FREE_TRADES=100

# Flash-crash simulation
CRASH_AUTO=1
CRASH_WINDOW_S=600
CRASH_SHOCK_MIN_PCT=0.02
CRASH_SHOCK_MAX_PCT=0.04
CRASH_PROB_NONE=0.03
CRASH_PROB_TWO=0.02
CRASH_DECAY=0.9

# Optional LLM judge (used by the autograder for strategy-report feedback)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=60000

# Set to 0 when running behind a single proxy / locally
TRUST_PROXY=1
MIN_PASSWORD_LENGTH=8

# ---- Tests (server/test) ----
# A separate database is created automatically; point this at a Postgres instance
TEST_DATABASE_URL=postgres://mercatus:mercatus@localhost:5432/mercatus_test

# ---- Web (web/) ----
# Leave blank for local dev — api.ts falls back to window.location.hostname:4040
# Set these on Vercel for production deployment:
# NEXT_PUBLIC_API_BASE=https://your-render-api.onrender.com
# NEXT_PUBLIC_WS_URL=wss://your-render-api.onrender.com/ws